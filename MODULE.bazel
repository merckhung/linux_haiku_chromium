# SPDX-License-Identifier: MIT
module(
    name = "linux_haiku_chromium",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_shell", version = "0.6.1")

haiku_repository = use_repo_rule("//bazel:repositories.bzl", "haiku_repository")
haiku_repository(
    name = "haiku",
    commit = "28a933369dcc6cd8b636be5ecc6bf0546e8cb8f6",
    remote = "https://github.com/haiku/haiku.git",
)

linux_kernel_repository = use_repo_rule("//bazel:repositories.bzl", "linux_kernel_repository")
linux_kernel_repository(
    name = "linux_kernel",
)

release_repository = use_repo_rule("//bazel:repositories.bzl", "release_repository")
release_repository(
    name = "busybox",
    sha256 = "b8cc24c9574d809e7279c3be349795c5d5ceb6fdf19ca709f80cde50e47de314",
    strip_prefix = "busybox-1.36.1",
    urls = ["https://busybox.net/downloads/busybox-1.36.1.tar.bz2"],
)

bazel_dep(name = "platforms", version = "1.0.0")

# Cross toolchain for the ARM64 (Raspberry Pi 4B / QEMU virt) Haiku userland.
register_toolchains("//bazel/toolchains:aarch64_linux_gnu_toolchain")

# Third-party libraries built from source for the ARM64 userland (the x86_64
# build links the host's system zlib/libpng/FreeType instead).
release_repository(
    name = "lhc_zlib",
    build_file = "//third_party:zlib.BUILD.bazel",
    sha256 = "9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23",
    strip_prefix = "zlib-1.3.1",
    urls = ["https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz"],
)

release_repository(
    name = "lhc_libpng",
    build_file = "//third_party:libpng.BUILD.bazel",
    sha256 = "6a5ca0652392a2d7c9db2ae5b40210843c0bbc081cbd410825ab00cc59f14a6c",
    strip_prefix = "libpng-1.6.43",
    urls = ["https://download.sourceforge.net/libpng/libpng-1.6.43.tar.xz"],
)

release_repository(
    name = "lhc_freetype",
    build_file = "//third_party:freetype.BUILD.bazel",
    sha256 = "12991c4e55c506dd7f9b765933e62fd2be2e06d421505d7950a132e4f1bb484d",
    strip_prefix = "freetype-2.13.2",
    urls = ["https://download.savannah.gnu.org/releases/freetype/freetype-2.13.2.tar.xz"],
)

release_repository(
    name = "lhc_expat",
    build_file = "//third_party:expat.BUILD.bazel",
    sha256 = "a695629dae047055b37d50a0ff4776d1d45d0a4c842cf4ccee158441f55ff7ee",
    strip_prefix = "expat-2.6.4",
    urls = ["https://github.com/libexpat/libexpat/releases/download/R_2_6_4/expat-2.6.4.tar.xz"],
)
