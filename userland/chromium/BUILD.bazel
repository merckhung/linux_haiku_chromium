# SPDX-License-Identifier: MIT
# Pre-built 64-bit Chromium (Haiku Ozone platform) for x86_64 and ARM64, the
# Chromium source patch used to produce them, and the Ozone platform sources
# for reference. Chromium is NOT compiled by this Bazel workspace; see
# patches/README.md to rebuild it from a Chromium checkout.
package(default_visibility = ["//visibility:public"])

PREBUILT_FILES = [
    "chrome",
    "chrome_crashpad_handler",
    "libEGL.so",
    "libGLESv2.so",
    "libffmpeg.so",
    "libvk_swiftshader.so",
    "vk_swiftshader_icd.json",
    "icudtl.dat",
    "v8_context_snapshot.bin",
    "snapshot_blob.bin",
    "chrome_100_percent.pak",
    "chrome_200_percent.pak",
    "resources.pak",
    "locales/en-US.pak",
]

exports_files(
    [
        "welcome.html",
        "patches/0001-chromium-ozone-haiku-linux.patch",
    ] + ["prebuilt/x86_64/" + f for f in PREBUILT_FILES] +
    ["prebuilt/arm64/" + f for f in PREBUILT_FILES],
)

filegroup(
    name = "prebuilt_chromium_x86_64",
    srcs = ["prebuilt/x86_64/" + f for f in PREBUILT_FILES],
)

filegroup(
    name = "prebuilt_chromium_arm64",
    srcs = ["prebuilt/arm64/" + f for f in PREBUILT_FILES],
)

filegroup(
    name = "ozone_haiku_sources",
    srcs = glob(["ozone_haiku/**"]),
)
