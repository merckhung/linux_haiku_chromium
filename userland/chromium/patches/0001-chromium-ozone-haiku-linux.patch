+namespace ui {
+
+namespace {
+
+int ConvertHaikuModifiers(uint32_t haiku_mods, uint32_t buttons) {
+  int flags = EF_NONE;
+  // Haiku modifiers from InterfaceDefs.h:
+  // B_SHIFT_KEY = 0x01, B_COMMAND_KEY = 0x02, B_CONTROL_KEY = 0x04,
+  // B_CAPS_LOCK = 0x08, B_OPTION_KEY = 0x40
+  if (haiku_mods & 0x01) {
+    flags |= EF_SHIFT_DOWN;
+  }
+  if (haiku_mods & 0x06) {
+    flags |= EF_CONTROL_DOWN;
+  }
+  if (haiku_mods & 0x40) {
+    flags |= EF_ALT_DOWN;
+  }
+  if (haiku_mods & 0x08) {
+    flags |= EF_CAPS_LOCK_ON;
+  }
+  if (buttons & 0x01) {
+    flags |= EF_LEFT_MOUSE_BUTTON;
+  }
+  if (buttons & 0x02) {
+    flags |= EF_RIGHT_MOUSE_BUTTON;
+  }
+  if (buttons & 0x04) {
+    flags |= EF_MIDDLE_MOUSE_BUTTON;
+  }
+  return flags;
+}
+
+KeyboardCode ConvertHaikuKeyToKeyboardCode(int32_t raw_char,
+                                           int32_t haiku_key,
+                                           const char* utf8) {
+  // Control-modified UTF-8 contains control bytes (Ctrl+L is 0x0c).
+  // Shortcuts need the original key; text insertion still uses ev.utf8.
+  unsigned char ch = raw_char > 0 && raw_char < 0x80
+                         ? static_cast<unsigned char>(raw_char)
+                         : (utf8 && utf8[0]
+                                ? static_cast<unsigned char>(utf8[0])
+                                : 0);
+  switch (ch) {
+    case 0x08:
+      return VKEY_BACK;
+    case 0x09:
+      return VKEY_TAB;
+    case 0x0a:
+    case 0x0d:
+      return VKEY_RETURN;
+    case 0x1b:
+      return VKEY_ESCAPE;
+    case 0x20:
+      return VKEY_SPACE;
+    case 0x7f:
+      return VKEY_DELETE;
+    default:
+      break;
+  }
+
+  // Haiku navigation key raw_char codes (InterfaceDefs.h):
+  // B_HOME=0x01, B_END=0x04, B_INSERT=0x05, B_PAGE_UP=0x0b, B_PAGE_DOWN=0x0c,
+  // B_LEFT_ARROW=0x1c, B_RIGHT_ARROW=0x1d, B_UP_ARROW=0x1e, B_DOWN_ARROW=0x1f
+  switch (raw_char) {
+    case 0x01:
+      return VKEY_HOME;
+    case 0x04:
+      return VKEY_END;
+    case 0x05:
+      return VKEY_INSERT;
+    case 0x0b:
+      return VKEY_PRIOR;
+    case 0x0c:
+      return VKEY_NEXT;
+    case 0x1c:
+      return VKEY_LEFT;
+    case 0x1d:
+      return VKEY_RIGHT;
+    case 0x1e:
+      return VKEY_UP;
+    case 0x1f:
+      return VKEY_DOWN;
+    default:
+      break;
+  }
+
+  if (ch >= 'a' && ch <= 'z') {
+    return static_cast<KeyboardCode>(VKEY_A + (ch - 'a'));
+  }
+  if (ch >= 'A' && ch <= 'Z') {
+    return static_cast<KeyboardCode>(VKEY_A + (ch - 'A'));
+  }
+  if (ch >= '0' && ch <= '9') {
+    return static_cast<KeyboardCode>(VKEY_0 + (ch - '0'));
+  }
+  switch (ch) {
+    case '-':
+    case '_':
+      return VKEY_OEM_MINUS;
+    case '=':
+    case '+':
+      return VKEY_OEM_PLUS;
+    case '[':
+    case '{':
+      return VKEY_OEM_4;
+    case ']':
+    case '}':
+      return VKEY_OEM_6;
+    case '\\':
+    case '|':
+      return VKEY_OEM_5;
+    case ';':
+    case ':':
+      return VKEY_OEM_1;
+    case '\'':
+    case '"':
+      return VKEY_OEM_7;
+    case ',':
+    case '<':
+      return VKEY_OEM_COMMA;
+    case '.':
+    case '>':
+      return VKEY_OEM_PERIOD;
+    case '/':
+    case '?':
+      return VKEY_OEM_2;
+    case '`':
+    case '~':
+      return VKEY_OEM_3;
+    default:
+      break;
+  }
+
+  return VKEY_UNKNOWN;
+}
