load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "app_server",
    srcs = [
        "AccelerantHWInterface.h",
        "LinuxEvdevEventStream.cpp",
        "LinuxEvdevEventStream.h",
        "LinuxFBHWInterface.cpp",
        "LinuxFBHWInterface.h",
        "LinuxFBRenderingBuffer.h",
        "RemoteHWInterfaceStub.cpp",
        "GlobalFontManager.cpp",
        "AppServer.cpp",
        "Desktop.cpp",
        "//userland:haiku_compat.h",
        "@haiku//:linprog_sources",
        "@haiku//:app_server_sources",
    ],
    copts = [
        "-std=c++20",
        "-O2",
        "-g",
        "-fno-omit-frame-pointer",
        "-D_GNU_SOURCE",
        "-Wno-multichar",
        "-Wno-address-of-packed-member",
        "-Wno-deprecated-enum-enum-conversion",
        "-Wno-deprecated-enum-float-conversion",
        "-Wno-format",
        "-Wno-unused-but-set-variable",
        "-Wno-unused-variable",
        "-include",
        "config/types.h",
        "-include",
        "userland/haiku_compat.h",
        "-iquote",
        "userland/haiku_app_server",
        "-iquote",
        "external/+haiku_repository+haiku/src/servers/app",
        "-iquote",
        "external/+haiku_repository+haiku/src/servers/app/decorator",
        "-iquote",
        "external/+haiku_repository+haiku/src/servers/app/drawing",
        "-iquote",
        "external/+haiku_repository+haiku/src/servers/app/drawing/Painter",
        "-iquote",
        "external/+haiku_repository+haiku/src/servers/app/drawing/Painter/bitmap_painter",
        "-iquote",
        "external/+haiku_repository+haiku/src/servers/app/drawing/Painter/drawing_modes",
        "-iquote",
        "external/+haiku_repository+haiku/src/servers/app/drawing/interface/remote",
        "-iquote",
        "external/+haiku_repository+haiku/src/servers/app/font",
        "-iquote",
        "external/+haiku_repository+haiku/src/servers/app/stackandtile",
        "-Iuserland/haiku_app_server",
    ] + select({
        "@platforms//cpu:aarch64": [],
        "//conditions:default": ["-I/usr/include/freetype2"],
    }),
    includes = [
        ".",
    ],
    linkopts = [
        "-rdynamic",
        "-lpthread",
        "-lrt",
        "-Wl,--allow-shlib-undefined",
    ] + select({
        "@platforms//cpu:aarch64": [],
        "//conditions:default": [
            "-lfreetype",
            "-lpng16",
            "-lz",
        ],
    }),
    deps = [
        "//userland/haiku_agg",
        "//userland/haiku_libbe:haiku_libbe_so",
        "//userland/haiku_libroot",
        "@haiku//:headers",
        "@haiku//:app_server_headers",
        "@haiku//:linprog_headers",
    ] + select({
        "@platforms//cpu:aarch64": [
            "@lhc_freetype//:freetype",
            "@lhc_libpng//:libpng",
            "@lhc_zlib//:zlib",
        ],
        "//conditions:default": [],
    }),
)
